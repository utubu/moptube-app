{
  "name": "moptube",
  "version": "0.1.1",
  "description": "MopTube desktop app",
  "main": "main.js",
  "author": "Popular",
  "license": "UNLICENSED",
  "repository": "github:utubu/moptube-app",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.moptube.app",
    "productName": "MopTube",
    "files": [
      "main.js",
      "src/**/*",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    },
    "publish": {
      "provider": "github"
    }
  }
}
